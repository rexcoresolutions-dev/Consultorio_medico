Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Sirve normalmente los archivos y directorios que sí existen.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router resuelve rutas como /login desde index.html.
  RewriteRule ^ index.html [L]
</IfModule>

